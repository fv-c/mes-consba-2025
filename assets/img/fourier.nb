Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "audio", ",", "stft", ",", "magnitudine", ",", "harmonicsCouples", ",", 
     "results", ",", "indici"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"audio", "=", 
   RowBox[{"Import", "[", "\"\<beethoven.mp3\>\"", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"audio", "=", 
    RowBox[{
     RowBox[{"AudioSplit", "[", 
      RowBox[{"audio", ",", "20"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stft", "=", 
    RowBox[{"ShortTimeFourier", "[", 
     RowBox[{
     "audio", ",", "stftSize", ",", "hopSize", ",", "BlackmanWindow", ",", 
      "stftSizePad", ",", 
      RowBox[{"FourierParameters", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", " ", 
         RowBox[{"-", "1"}]}], "}"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"magnitudine", "=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"stft", "[", "\"\<Data\>\"", "]"}], "]"}], "^", "1"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"binsCouples", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"FindPeaks", "[", 
       RowBox[{"#", ",", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"100", ",", "stftSizePad"}], "]"}], "^", "2"}]}], 
       RowBox[{"(*", 
        RowBox[{"vedi", " ", "manuale"}], "*)"}], "]"}], "&"}], "/@", 
     RowBox[{"magnitudine", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{";;", "halfStftSizePad"}]}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"harmonicsCouples0", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}], "*", 
          "freqFondFFT"}], ",", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", "#"}], "&"}], 
    "/@", "binsCouples"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"harmonicsCouples", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"#", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ">=", 
           RowBox[{"10", "^", 
            RowBox[{"-", "20"}]}]}], "&&", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ">=", 
           RowBox[{"(", 
            RowBox[{"2", "*", "freqFondFFT"}], ")"}]}]}], "&"}]}], "]"}], 
      "&"}], "/@", "harmonicsCouples0"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"results", "=", 
   RowBox[{"Parallelize", "@", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"indici", " ", "=", 
         RowBox[{"getUniquePairIndices", "[", 
          RowBox[{"Length", "@", 
           RowBox[{"harmonicsCouples", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Total", "[", 
         RowBox[{"dissonanceNumberCompilata", "/@", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"harmonicsCouples", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "#"}], "]"}], "]"}], "&"}], ",", "indici"}], 
           "]"}]}], "]"}]}], "\[IndentingNewLine]", ")"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "@", "magnitudine"}]}], "}"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], ";"}]}], "Input",
